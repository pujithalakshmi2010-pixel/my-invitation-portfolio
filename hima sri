<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Happy Birthday 💖Hima sri💗</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --gold: #f4d17b;
    --light-gold: #fff0bd;
    --pink: #ff77b7;
    --white: #ffffff;
}

html,
body {
    width: 100%;
    min-height: 100%;
}

body {
    font-family: 'Poppins', sans-serif;
    overflow: hidden;
    background: #080808;
    color: white;
}

.screen {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    display: none;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.screen.active {
    display: flex;
    animation: screenAppear 1s ease;
}

@keyframes screenAppear {
    from { opacity: 0; }
    to { opacity: 1; }
}

/* BLACK AND WHITE CINEMATIC BACKGROUND */

.dark-background {
    background:
        radial-gradient(
            ellipse at center,
            rgba(90, 90, 90, 0.35),
            transparent 65%
        ),
        linear-gradient(
            135deg,
            #030303 0%,
            #202020 45%,
            #050505 100%
        );
}

.dark-background::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;

    background:
        radial-gradient(
            circle at 20% 25%,
            rgba(255,255,255,0.10),
            transparent 30%
        ),
        radial-gradient(
            circle at 80% 75%,
            rgba(255,255,255,0.08),
            transparent 35%
        );

    z-index: 0;
}

.gold {
    color: var(--gold);
    text-shadow:
        0 0 8px rgba(244, 209, 123, 0.35),
        0 0 22px rgba(244, 209, 123, 0.15);
}

.eyebrow {
    color: var(--light-gold);
    font-size: 11px;
    letter-spacing: 5px;
    text-transform: uppercase;
    margin-bottom: 24px;
}

/* =================================
   SCREEN 1: NORMAL PINK BALLOON
================================= */

#screen1 {
    background:
        radial-gradient(
            ellipse at center,
            rgba(100,100,100,0.28),
            transparent 60%
        ),
        linear-gradient(
            140deg,
            #030303,
            #242424 50%,
            #050505
        );
}

.intro-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 520px;
    padding: 25px;

    display: flex;
    flex-direction: column;
    align-items: center;
}

.intro-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(29px, 8vw, 45px);
    font-weight: 500;
    line-height: 1.3;
    margin-bottom: 18px;
}

.intro-subtitle {
    font-size: 11px;
    letter-spacing: 3px;
    line-height: 2;
    color: #f1dca5;
    margin-bottom: 45px;
}

.balloon-area {
    position: relative;
    width: 180px;
    height: 245px;

    display: flex;
    justify-content: center;
    align-items: flex-start;
}

/* NORMAL OVAL BALLOON */

.heart-balloon {
    position: relative;
    width: 76px;
    height: 100px;
    margin-top: 10px;

    background: radial-gradient(
        circle at 30% 25%,
        #ffc0df,
        #ff78b8 45%,
        #e72c83 100%
    );

    border-radius: 50% 50% 45% 45%;

    filter: drop-shadow(
        0 0 25px rgba(255, 70, 160, 0.4)
    );

    cursor: pointer;
    animation: balloonPulse 2s ease-in-out infinite;
    transition: opacity 0.3s, transform 0.3s;
}

/* Small highlight */

.heart-balloon .shine {
    position: absolute;
    z-index: 3;

    width: 12px;
    height: 27px;

    background: rgba(255,255,255,0.45);
    border-radius: 50%;

    top: 15px;
    left: 17px;

    transform: rotate(25deg);
}

/* Balloon movement */

@keyframes balloonPulse {
    0%, 100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.06);
    }
}

/* Hanging string */

.balloon-string {
    position: absolute;
    top: 110px;
    left: 50%;

    width: 1px;
    height: 78px;

    background: linear-gradient(
        to bottom,
        #f9e8c2,
        rgba(255,255,255,0.3)
    );

    transform: translateX(-50%);
    transform-origin: top;

    animation: stringSwing 3s ease-in-out infinite;
}

@keyframes stringSwing {
    0%, 100% {
        transform: translateX(-50%) rotate(-4deg);
    }

    50% {
        transform: translateX(-50%) rotate(4deg);
    }
}

.tap-text {
    margin-top: 0;
    font-size: 10px;
    letter-spacing: 4px;
    color: var(--light-gold);
    animation: textGlow 2s infinite;
}

@keyframes textGlow {
    0%, 100% { opacity: 0.65; }
    50% { opacity: 1; }
}

/* Balloon pop animation */

.balloon-pop {
    animation: popBalloon 0.45s ease forwards !important;
}

@keyframes popBalloon {
    0% {
        opacity: 1;
        transform: scale(1);
    }

    60% {
        opacity: 1;
        transform: scale(1.4);
    }

    100% {
        opacity: 0;
        transform: scale(0);
    }
}

.sparkle {
    position: absolute;
    width: 6px;
    height: 6px;
    background: var(--gold);
    border-radius: 50%;
    pointer-events: none;
    animation: sparkleFly 0.7s ease-out forwards;
}

@keyframes sparkleFly {
    from {
        opacity: 1;
        transform: translate(0, 0) scale(1);
    }

    to {
        opacity: 0;
        transform: translate(var(--dx), var(--dy)) scale(0);
    }
}

/* =================================
   SCREEN 2: BIRTHDAY WISHES
================================= */

#screen2 {
    background:
        radial-gradient(
            ellipse at center,
            rgba(100,100,100,0.28),
            transparent 60%
        ),
        linear-gradient(
            140deg,
            #030303,
            #242424 50%,
            #050505
        );
}

.screen2-content {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 520px;
    max-height: 100%;
    overflow-y: auto;
    padding: 24px 22px;
    scrollbar-width: none;
}

.screen2-content::-webkit-scrollbar {
    display: none;
}

.birthday-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(34px, 9vw, 52px);
    font-weight: 600;
    line-height: 1.15;
    margin-bottom: 8px;
}

.birthday-name {
    font-family: 'Playfair Display', serif;
    font-size: clamp(23px, 6vw, 31px);
    color: #fff0bd;
    margin-bottom: 22px;
    letter-spacing: 2px;
}

.cake {
    font-size: 66px;
    margin: 10px 0 18px;
    display: inline-block;

    filter: drop-shadow(
        0 0 14px rgba(244,209,123,0.2)
    );

    animation: cakeFloat 3s ease-in-out infinite;
}

@keyframes cakeFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
}

.wish-card {
    position: relative;
    max-width: 400px;
    margin: 0 auto 25px;
    padding: 22px 18px;

    border: 1px solid rgba(244, 209, 123, 0.45);
    border-radius: 14px;

    background: rgba(255,255,255,0.045);
    box-shadow: 0 0 30px rgba(0,0,0,0.3);
}

.wish-card p {
    font-family: 'Playfair Display', serif;
    color: #fff3d0;
    font-size: 15px;
    line-height: 1.9;
}

.wish-card .small-wish {
    margin-top: 13px;
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    color: #e9d6a2;
    line-height: 1.8;
}

.gold-button {
    position: relative;
    z-index: 5;
    display: inline-block;

    padding: 13px 28px;
    border: 1px solid var(--gold);
    border-radius: 30px;

    background: linear-gradient(
        135deg,
        #f7e3a3,
        #d4a94d
    );

    color: #17110a;
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;

    box-shadow: 0 0 24px rgba(244,209,123,0.2);
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
}

.gold-button:active {
    transform: scale(0.96);
}

.gold-button:hover {
    box-shadow: 0 0 32px rgba(244,209,123,0.4);
}

/* FALLING BALLOONS */

.falling-balloons {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
}

.falling-balloon {
    position: absolute;
    top: -40px;

    width: 22px;
    height: 29px;

    border-radius: 50% 50% 45% 45%;
    opacity: 0.7;

    animation: balloonFall linear infinite;
}

.falling-balloon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 28px;

    width: 1px;
    height: 25px;

    background: rgba(255,255,255,0.45);
}

/* Smooth, moderately fast falling */

@keyframes balloonFall {
    0% {
        transform: translateY(-40px) translateX(0) rotate(0deg);
    }

    50% {
        transform: translateY(50vh) translateX(15px) rotate(8deg);
    }

    100% {
        transform: translateY(110vh) translateX(-10px) rotate(-8deg);
    }
}

/* =================================
   SCREEN 3: ORIGINAL PHOTO DESIGN
================================= */

#screen3 {
    background: #050505;
    isolation: isolate;
}

.background-photo {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    filter: grayscale(100%) brightness(0.43);
    z-index: -3;
}

.photo-overlay {
    position: absolute;
    inset: 0;
    z-index: -2;

    background: linear-gradient(
        to bottom,
        rgba(0,0,0,0.55),
        rgba(0,0,0,0.2) 45%,
        rgba(0,0,0,0.75)
    );
}

.screen3-content {
    position: relative;
    z-index: 2;

    width: 100%;
    max-height: 100%;

    overflow-y: auto;
    scrollbar-width: none;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding: 24px 18px;
}

.screen3-content::-webkit-scrollbar {
    display: none;
}

.final-title {
    font-family: 'Playfair Display', serif;
    color: var(--gold);
    font-size: clamp(27px, 7.5vw, 40px);
    font-weight: 500;
    line-height: 1.35;

    max-width: 430px;
    margin-bottom: 22px;

    text-shadow:
        0 0 10px rgba(244,209,123,0.5),
        0 2px 15px rgba(0,0,0,0.8);
}

.photo-garden {
    position: relative;
    width: min(76vw, 285px);
    height: min(76vw, 285px);
    margin: 0 auto 22px;
}

/* CENTER PHOTO FRAME */

.photo-frame {
    position: absolute;
    inset: 10px;

    padding: 7px;
    border: 1px solid var(--gold);
    border-radius: 8px;

    background: rgba(0,0,0,0.65);

    box-shadow:
        0 0 20px rgba(244,209,123,0.18),
        0 10px 40px rgba(0,0,0,0.5);

    overflow: hidden;
}

.photo-frame img {
    display: block;
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    border-radius: 4px;
}

/* DECORATIVE LEAFY STEMS */

.leaf-stem {
    position: absolute;
    width: 3px;
    height: 160px;

    border-radius: 50%;

    background: linear-gradient(
        to bottom,
        #d9b76a,
        #657a51
    );

    z-index: 4;
    pointer-events: none;
}

.leaf-stem.left {
    left: -1px;
    top: 30px;
    transform: rotate(-24deg);
}

.leaf-stem.right {
    right: -1px;
    top: 30px;
    transform: rotate(24deg);
}

.leaf {
    position: absolute;

    width: 24px;
    height: 12px;

    border-radius: 100% 0 100% 0;

    background: linear-gradient(
        135deg,
        #a6b879,
        #526a3c
    );

    box-shadow: 0 0 6px rgba(0,0,0,0.3);
}

.left .leaf:nth-child(1) {
    left: 2px;
    top: 15px;
    transform: rotate(-30deg);
}

.left .leaf:nth-child(2) {
    left: -21px;
    top: 43px;
    transform: rotate(30deg) scaleX(-1);
}

.left .leaf:nth-child(3) {
    left: 3px;
    top: 73px;
    transform: rotate(-30deg);
}

.left .leaf:nth-child(4) {
    left: -19px;
    top: 105px;
    transform: rotate(30deg) scaleX(-1);
}

.left .leaf:nth-child(5) {
    left: 3px;
    top: 133px;
    transform: rotate(-30deg);
}

.right .leaf:nth-child(1) {
    right: 2px;
    top: 15px;
    transform: rotate(30deg) scaleX(-1);
}

.right .leaf:nth-child(2) {
    right: -21px;
    top: 43px;
    transform: rotate(-30deg);
}

.right .leaf:nth-child(3) {
    right: 3px;
    top: 73px;
    transform: rotate(30deg) scaleX(-1);
}

.right .leaf:nth-child(4) {
    right: -19px;
    top: 105px;
    transform: rotate(-30deg);
}

.right .leaf:nth-child(5) {
    right: 3px;
    top: 133px;
    transform: rotate(30deg) scaleX(-1);
}

/* FLOATING DECORATIVE HEARTS */

.heart-decoration {
    position: absolute;
    z-index: 5;

    font-size: 25px;

    filter: drop-shadow(
        0 0 8px rgba(255,105,170,0.3)
    );

    animation: heartFloat 3s ease-in-out infinite;
}

.heart-one {
    left: -12px;
    top: -3px;
}

.heart-two {
    right: -10px;
    top: 30px;
    animation-delay: 0.8s;
}

.heart-three {
    right: 4px;
    bottom: -5px;
    animation-delay: 1.4s;
}

@keyframes heartFloat {
    0%, 100% {
        transform: translateY(0) rotate(-5deg);
    }

    50% {
        transform: translateY(-9px) rotate(5deg);
    }
}

.final-message {
    max-width: 400px;

    font-family: 'Playfair Display', serif;
    color: #fff3d4;
    font-size: 16px;
    line-height: 1.9;

    text-shadow: 0 2px 8px rgba(0,0,0,0.9);

    margin-bottom: 12px;
}

.signature {
    color: var(--gold);
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    font-style: italic;
    margin-top: 5px;

    text-shadow: 0 0 12px rgba(244,209,123,0.35);
}

/* MOBILE HEIGHT ADJUSTMENTS */

@media (max-height: 700px) {

    .intro-content {
        transform: scale(0.88);
    }

    .screen2-content {
        padding-top: 12px;
        padding-bottom: 12px;
    }

    .cake {
        font-size: 52px;
        margin: 4px 0 10px;
    }

    .wish-card {
        padding: 14px;
        margin-bottom: 16px;
    }

    .photo-garden {
        width: min(64vw, 230px);
        height: min(64vw, 230px);
    }

    .final-title {
        margin-bottom: 12px;
    }

    .final-message {
        font-size: 14px;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
    }
}
</style>
</head>

<body>

<!-- =================================
     SCREEN 1
================================= -->

<section id="screen1" class="screen active dark-background">

    <div class="intro-content">

        <p class="eyebrow">A Little Moment of Magic</p>

        <h1 class="intro-title gold">
            A Little Surprise<br>
            for You
        </h1>

        <p class="intro-subtitle">
            SOMEONE SPECIAL IS WAITING...
        </p>

        <div class="balloon-area">

            <div
                class="heart-balloon"
                id="mainBalloon"
                role="button"
                tabindex="0"
                aria-label="Pop the pink balloon"
            >
                <span class="shine"></span>
            </div>

            <div
                class="balloon-string"
                id="balloonString"
            ></div>

        </div>

        <p class="tap-text" id="tapText">
            TAP THE BALLOON
        </p>

    </div>

</section>


<!-- =================================
     SCREEN 2
================================= -->

<section id="screen2" class="screen dark-background">

    <div
        class="falling-balloons"
        id="fallingBalloons"
    ></div>

    <div class="screen2-content">

        <p class="eyebrow">Today Is All About You</p>

        <h1 class="birthday-heading gold">
            Happy<br>
            Birthday
        </h1>

        <h2 class="birthday-name">
            Hima sri 💗
        </h2>

        <div class="cake">🎂🌟</div>

        <div class="wish-card">

            <p>
                May your special day be filled with
                beautiful moments, endless smiles,
                and all the happiness your heart deserves.
            </p>

            <p class="small-wish">
                May every dream bring you closer
                to a beautiful tomorrow, and may
                your life always shine with love,
                laughter, and wonderful memories. ✨
            </p>

        </div>

        <button
            class="gold-button"
            id="surpriseButton"
            type="button"
        >
            ANOTHER SURPRISE ✨
        </button>

    </div>

</section>


<!-- =================================
     SCREEN 3
     UNCHANGED PHOTO DESIGN
================================= -->

<section id="screen3" class="screen">

    <!-- FULL-SCREEN BACKGROUND PHOTO -->

    <img
        class="background-photo"
        src="birthday-background.jpg"
        alt=""
        aria-hidden="true"
    >

    <div class="photo-overlay"></div>

    <div class="screen3-content">

        <p class="eyebrow">A Wish From the Pavan</p>

        <h1 class="final-title">
            A Very Special<br>
            Wish for You 💗
        </h1>

        <div class="photo-garden">

            <div class="leaf-stem left">
                <span class="leaf"></span>
                <span class="leaf"></span>
                <span class="leaf"></span>
                <span class="leaf"></span>
                <span class="leaf"></span>
            </div>

            <div class="leaf-stem right">
                <span class="leaf"></span>
                <span class="leaf"></span>
                <span class="leaf"></span>
                <span class="leaf"></span>
                <span class="leaf"></span>
            </div>

            <span class="heart-decoration heart-one">💗</span>
            <span class="heart-decoration heart-two">🎈</span>
            <span class="heart-decoration heart-three">💕</span>

            <!-- CENTER PHOTO -->

            <div class="photo-frame">

                <img
                    src="birthday-photo.jpg"
                    alt="Hima sri's birthday photo"
                >

            </div>

        </div>

        <p class="final-message">
            You deserve all the beautiful things
            life has to offer. May your days be
            filled with love, your heart with joy,
            and your future with countless reasons
            to smile. 💖
        </p>

        <p class="signature">
            Keep shining, Hima sri ✨
        </p>

    </div>

</section>


<script>

/* =================================
   SCREEN NAVIGATION
================================= */

const screen1 = document.getElementById("screen1");
const screen2 = document.getElementById("screen2");
const screen3 = document.getElementById("screen3");

function showScreen(screenToShow) {

    [screen1, screen2, screen3].forEach(function(screen) {
        screen.classList.remove("active");
    });

    screenToShow.classList.add("active");
}


/* =================================
   SCREEN 1: POP THE NORMAL BALLOON
================================= */

const mainBalloon = document.getElementById("mainBalloon");
const balloonString = document.getElementById("balloonString");
const tapText = document.getElementById("tapText");

let balloonPopped = false;

function popBalloon() {

    if (balloonPopped) {
        return;
    }

    balloonPopped = true;

    const rect = mainBalloon.getBoundingClientRect();

    const centerX = rect.left + rect.width / 2;
    const centerY = rect.top + rect.height / 2;

    mainBalloon.classList.add("balloon-pop");

    balloonString.style.opacity = "0";
    tapText.style.opacity = "0";

    /* Golden sparkle explosion */

    for (let i = 0; i < 26; i++) {

        const sparkle = document.createElement("span");

        sparkle.className = "sparkle";

        sparkle.style.left = centerX + "px";
        sparkle.style.top = centerY + "px";

        sparkle.style.setProperty(
            "--dx",
            (Math.random() - 0.5) * 240 + "px"
        );

        sparkle.style.setProperty(
            "--dy",
            (Math.random() - 0.5) * 240 + "px"
        );

        document.body.appendChild(sparkle);

        setTimeout(function() {
            sparkle.remove();
        }, 800);
    }

    setTimeout(function() {

        showScreen(screen2);

        startFallingBalloons();

    }, 650);
}

mainBalloon.addEventListener("click", popBalloon);

mainBalloon.addEventListener("keydown", function(event) {

    if (event.key === "Enter" || event.key === " ") {

        event.preventDefault();

        popBalloon();
    }

});


/* =================================
   SCREEN 2: FALLING BALLOONS
================================= */

const fallingBalloons =
    document.getElementById("fallingBalloons");

let balloonInterval = null;

const balloonColors = [
    "#d5b05c",
    "#ff78b8",
    "#f3e0ad",
    "#b9b9b9",
    "#e7a1c2",
    "#ffffff"
];

function createFallingBalloon() {

    const balloon = document.createElement("div");

    balloon.className = "falling-balloon";

    balloon.style.left = Math.random() * 100 + "%";

    balloon.style.background =
        balloonColors[
            Math.floor(Math.random() * balloonColors.length)
        ];

    balloon.style.animationDuration =
        (7 + Math.random() * 4) + "s";

    /* No random delay: balloons start falling immediately */

    balloon.style.animationDelay = "0s";

    balloon.style.transform =
        "scale(" + (0.7 + Math.random() * 0.7) + ")";

    fallingBalloons.appendChild(balloon);

    setTimeout(function() {
        balloon.remove();
    }, 12000);
}

function startFallingBalloons() {

    if (balloonInterval !== null) {
        return;
    }

    /* Show balloons as soon as screen 2 opens */

    for (let i = 0; i < 12; i++) {
        createFallingBalloon();
    }

    /* Continue adding balloons */

    balloonInterval = setInterval(function() {
        createFallingBalloon();
    }, 500);
}


/* =================================
   SCREEN 2: ANOTHER SURPRISE
================================= */

const surpriseButton =
    document.getElementById("surpriseButton");

surpriseButton.addEventListener("click", function() {

    if (balloonInterval !== null) {

        clearInterval(balloonInterval);

        balloonInterval = null;
    }

    showScreen(screen3);

});


/* =================================
   PHOTO FALLBACKS
================================= */

const backgroundPhoto =
    document.querySelector(".background-photo");

backgroundPhoto.addEventListener("error", function() {

    backgroundPhoto.style.display = "none";

    document.getElementById("screen3").style.background =
        "linear-gradient(135deg, #050505, #252525, #050505)";

});

const centerPhoto =
    document.querySelector(".photo-frame img");

centerPhoto.addEventListener("error", function() {

    centerPhoto.style.display = "none";

    const frame = document.querySelector(".photo-frame");

    frame.style.background =
        "linear-gradient(135deg, #222, #080808, #333)";

    frame.style.display = "flex";
    frame.style.alignItems = "center";
    frame.style.justifyContent = "center";

    const placeholder = document.createElement("div");

    placeholder.textContent = "💗";

    placeholder.style.fontSize = "55px";

    frame.appendChild(placeholder);

});

</script>

